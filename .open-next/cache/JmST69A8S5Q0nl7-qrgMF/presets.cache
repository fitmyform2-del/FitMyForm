58-3.9A1 1 0 0 0 22 12\"></path><path d=\"M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17\"></path></svg><span class=\"hidden md:inline\">Exam Presets</span></button></nav></div></header><main class=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8\"><div class=\"text-center space-y-3\"><div class=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-blue-950/80 border border-blue-500/30 text-blue-300 text-xs font-semibold\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-layers w-3.5 h-3.5 text-blue-400\" aria-hidden=\"true\"><path d=\"M12.83 2.18a2 2 0 0 0-1.66 0L2.6 6.08a1 1 0 0 0 0 1.83l8.58 3.91a2 2 0 0 0 1.66 0l8.58-3.9a1 1 0 0 0 0-1.83z\"></path><path d=\"M2 12a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 12\"></path><path d=\"M2 17a1 1 0 0 0 .58.91l8.6 3.91a2 2 0 0 0 1.65 0l8.58-3.9A1 1 0 0 0 22 17\"></path></svg><span>Official Exam Requirements Directory</span></div><h1 class=\"text-3xl sm:text-4xl font-extrabold text-white\">Indian Competitive Exam <span class=\"gradient-text\">Photo &amp; Document Specs</span></h1><p class=\"text-xs sm:text-sm text-gray-300 max-w-2xl mx-auto\">Browse official document dimension specifications, file format rules, and KB size limits for over 30+ competitive exams.</p></div><div class=\"bg-gray-900 border border-gray-800 rounded-2xl p-4 space-y-4 max-w-3xl mx-auto shadow-xl\"><div class=\"relative\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-gray-400\" aria-hidden=\"true\"><path d=\"m21 21-4.34-4.34\"></path><circle cx=\"11\" cy=\"11\" r=\"8\"></circle></svg><input type=\"text\" placeholder=\"Search exam specs e.g. &#x27;SSC CGL&#x27;, &#x27;UPSC&#x27;, &#x27;IBPS PO&#x27;, &#x27;NEET&#x27;...\" class=\"w-full bg-gray-950 text-white pl-10 pr-4 py-2.5 rounded-xl border border-gray-800 text-sm focus:outline-none focus:border-blue-500\" value=\"\"/></div><div class=\"flex flex-wrap gap-1.5 text-xs justify-center\"><button class=\"px-3 py-1.5 rounded-lg font-medium transition-all bg-blue-600 text-white shadow-md\">All Exams</button><button class=\"px-3 py-1.5 rounded-lg font-medium transition-all bg-gray-800 text-gray-400 hover:text-white\">National (SSC/UPSC)</button><button class=\"px-3 py-1.5 rounded-lg font-medium transition-all bg-gray-800 text-gray-400 hover:text-white\">Banking &amp; IBPS</button><button class=\"px-3 py-1.5 rounded-lg font-medium transition-all bg-gray-800 text-gray-400 hover:text-white\">Railway RRB</button><button class=\"px-3 py-1.5 rounded-lg font-medium transition-all bg-gray-800 text-gray-400 hover:text-white\">CTET / UPTET</button><button class=\"px-3 py-1.5 rounded-lg font-medium transition-all bg-gray-800 text-gray-400 hover:text-white\">State Exams</button></div></div><div class=\"grid grid-cols-1 md:grid-cols-2 gap-6\"><div class=\"bg-gray-900 border border-gray-800 rounded-2xl p-5 space-y-4 shadow-xl\"><div class=\"flex items-center justify-between border-b border-gray-800 pb-3\"><div><h3 class=\"font-bold text-white text-base\">SSC (CGL / CHSL / MTS / GD)</h3><p class=\"text-xs text-gray-400\">Staff Selection Commission</p></div><span class=\"text-[10px] uppercase font-semibold text-blue-400 bg-blue-950 px-2.5 py-1 rounded-full border border-blue-800\">national</span></div><div class=\"space-y-3\"><div class=\"bg-gray-950 border border-gray-800 rounded-xl p-3.5 space-y-1 text-xs\"><div class=\"flex items-center justify-between\"><span class=\"font-bold text-white\">SSC Passport Photo</span><span class=\"font-mono bg-gray-800 text-emerald-400 px-2 py-0.5 rounded text-[10px]\">JPG, JPEG</span></div><div class=\"flex flex-wrap gap-x-4 gap-y-1 text-gray-300 font-mono pt-1\"><div>Size: <strong class=\"text-emerald-400\">20<!-- -->–<!-- -->50<!-- --> KB</strong></div><div>Dim: <strong class=\"text-blue-300\">200<!-- --> × <!-- -->230<!-- --> px</strong></div></div><p class=\"text-[11px] text-gray-400 pt-1 border-t border-gray-800/60\">White background mandatory. Dimensions 3.5 cm x 4.5 cm (200 x 230 px).</p></div><div class=\"bg-gray-950 border border-gray-800 rounded-xl p-3.5 space-y-1 text-xs\"><div class=\"flex items-center justify-between\"><span class=\"font-bold text-white\">SSC Signature</span><span class=\"font-mono bg-gray-800 text-emerald-400 px-2 py-0.5 rounded text-[10px]\">JPG, JPEG</span></div><div class=\"flex flex-wrap gap-x-4 gap-y-1 text-gray-300 font-mono pt-1\"><div>Size: <strong class=\"text-emerald-400\">10<!-- -->–<!-- -->20<!-- --> KB</strong></div><div>Dim: <strong class=\"text-blue-300\">140<!-- --> × <!-- -->60<!-- --> px</strong></div></div><p class=\"text-[11px] text-gray-400 pt-1 border-t border-gray-800/60\">Black ink signature on white paper. Dimensions 4.0 cm x 2.0 cm (140 x 60 px).</p></div></div><a class=\"block text-center w-full py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl transition-all shadow-md\" href=\"/\">Use Requirements in Resizer Tool →</a></div><div class=\"bg-gray-900 border border-gray-800 rounded-2xl p-5 space-y-4 shadow-xl\"><div class=\"flex items-center justify-between border-b border-gray-800 pb-3\"><div><h3 class=\"font-bold text-white text-base\">UPSC (IAS / IPS / NDA / CDS)</h3><p class=\"text-xs text-gray-400\">Union Public Service Commission</p></div><span class=\"text-[10px] uppercase font-semibold text-blue-400 bg-blue-950 px-2.5 py-1 rounded-full border border-blue-800\">national</span></div><div class=\"space-y-3\"><div class=\"bg-gray-950 border border-gray-800 rounded-xl p-3.5 space-y-1 text-xs\"><div class=\"flex items-center justify-between\"><span class=\"font-bold text-white\">UPSC Photograph</span><span class=\"font-mono bg-gray-800 text-emerald-400 px-2 py-0.5 rounded text-[10px]\">JPG, JPEG</span></div><div class=\"flex flex-wrap gap-x-4 gap-y-1 text-gray-300 font-mono pt-1\"><div>Size: <strong class=\"text-emerald-400\">20<!-- -->–<!-- -->300<!-- --> KB</strong></div><div>Dim: <strong class=\"text-blue-300\">350<!-- --> × <!-- -->350<!-- --> px</strong></div></div><p class=\"text-[11px] text-gray-400 pt-1 border-t border-gray-800/60\">Min 350x350 px, Max 1000x1000 px. White background with name and date.</p></div><div class=\"bg-gray-950 border border-gray-800 rounded-xl p-3.5 space-y-1 text-xs\"><div class=\"flex items-center justify-between\"><span class=\"font-bold text-white\">UPSC Signature</span><span class=\"font-mono bg-gray-800 text-emerald-400 px-2 py-0.5 rounded text-[10px]\">JPG, JPEG</span></div><div class=\"flex flex-wrap gap-x-4 gap-y-1 text-gray-300 font-mono pt-1\"><div>Size: <strong class=\"text-emerald-400\">20<!-- -->–<!-- -->300<!-- --> KB</strong></div><div>Dim: <strong class=\"text-blue-300\">350<!-- --> × <!-- -->350<!-- --> px</strong></div></div><p class=\"text-[11px] text-gray-400 pt-1 border-t border-gray-800/60\">Dark ink signature on plain white paper.</p></div><div class=\"bg-gray-950 border border-gray-800 rounded-xl p-3.5 space-y-1 text-xs\"><div class=\"flex items-center justify-between\"><span class=\"font-bold text-white\">UPSC Photo ID Proof (Aadhaar/Voter)</span><span class=\"font-mono bg-gray-800 text-emerald-400 px-2 py-0.5 rounded text-[10px]\">PDF</span></div><div class=\"flex flex-wrap gap-x-4 gap-y-1 text-gray-300 font-mono pt-1\"><div>Size: <strong class=\"text-emerald-400\">20<!-- -->–<!-- -->300<!-- --> KB</strong></div></div><p class=\"text-[11px] text-gray-400 pt-1 border-t border-gray-800/60\">PDF format only. Size must be between 20 KB and 300 KB.</p></div></div><a class=\"block text-center w-full py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl transition-all shadow-md\" href=\"/\">Use Requirements in Resizer Tool →</a></div><div class=\"bg-gray-900 border border-gray-800 rounded-2xl p-5 space-y-4 shadow-xl\"><div class=\"flex items-center justify-between border-b border-gray-800 pb-3\"><div><h3 class=\"font-bold text-white text-base\">Banking (IBPS PO / Clerk / SBI PO)</h3><p class=\"text-xs text-gray-400\">Institute of Banking Personnel Selection / SBI</p></div><span class=\"text-[10px] uppercase font-semibold text-blue-400 bg-blue-950 px-2.5 py-1 rounded-full border border-blue-800\">banking</span></div><div class=\"space-y-3\"><div class=\"bg-gray-950 border border-gray-800 rounded-xl p-3.5 space-y-1 text-xs\"><div class=\"flex items-center justify-between\"><span class=\"font-bold text-white\">IBPS Passport Photo</span><span class=\"font-mono bg-gray-800 text-emerald-400 px-2 py-0.5 rounded text-[10px]\">JPG, JPEG</span></div><div class=\"flex flex-wrap gap-x-4 gap-y-1 text-gray-300 font-mono pt-1\"><div>Size: <strong class=\"text-emerald-400\">20<!-- -->–<!-- -->50<!-- --> KB</strong></div><div>Dim: <strong class=\"text-blue-300\">200<!-- --> × <!-- -->230<!-- --> px</strong></div></div><p class=\"text-[11px] text-gray-400 pt-1 border-t border-gray-800/60\">Size 20 KB to 50 KB. 200 x 230 pixels.</p></div><div class=\"bg-gray-950 border border-gray-800 rounded-xl p-3.5 space-y-1 text-xs\"><div class=\"flex items-center justify-between\"><span class=\"font-bold text-white\">IBPS Signature</span><span class=\"font-mono bg-gray-800 text-emerald-400 px-2 py-0.5 rounded text-[10px]\">JPG, JPEG</span></div><div class=\"flex flex-wrap gap-x-4 gap-y-1 text-gray-300 font-mono pt-1\"><div>Size: <strong class=\"text-emerald-400\">10<!-- -->–<!-- -->20<!-- --> KB</strong></div><div>Dim: <strong class=\"text-blue-300\">140<!-- --> × <!-- -->60<!-- --> px</strong></div></div><p class=\"text-[11px] text-gray-400 pt-1 border-t border-gray-800/60\">Black ink only. Size 10 KB to 20 KB.</p></div><div class=\"bg-gray-950 border border-gray-800 rounded-xl p-3.5 space-y-1 text-xs\"><div class=\"flex items-center justify-between\"><span class=\"font-bold text-white\">IBPS Left Thumb Impression</span><span class=\"font-mono bg-gray-800 text-emerald-400 px-2 py-0.5 rounded text-[10px]\">JPG, JPEG</span></div><div class=\"flex flex-wrap gap-x-4 gap-y-1 text-gray-300 font-mono pt-1\"><div>Size: <strong class=\"text-emerald-400\">20<!-- -->–<!-- -->50<!-- --> KB</strong></div><div>Dim: <strong class=\"text-blue-300\">240<!-- --> × <!-- -->240<!-- --> px</strong></div></div><p class=\"text-[11px] text-gray-400 pt-1 border-t border-gray-800/60\">Blue or black ink on white paper. 240 x 240 pixels (3 cm x 3 cm).</p></div><div class=\"bg-gray-950 border border-gray-800 rounded-xl p-3.5 space-y-1 text-xs\"><div class=\"flex items-center justify-between\"><span class=\"font-bold text-white\">IBPS Handwritten Declaration</span><span class=\"font-mono bg-gray-800 text-emerald-400 px-2 py-0.5 rounded text-[10px]\">JPG, JPEG</span></div><div class=\"flex flex-wrap gap-x-4 gap-y-1 text-gray-300 font-mono pt-1\"><div>Size: <strong class=\"text-emerald-400\">50<!-- -->–<!-- -->100<!-- --> KB</strong></div><div>Dim: <strong class=\"text-blue-300\">800<!-- --> × <!-- -->400<!-- --> px</strong></div></div><p class=\"text-[11px] text-gray-400 pt-1 border-t border-gray-800/60\">Handwritten statement in English on white paper with black ink. 800 x 400 pixels.</p></div></div><a class=\"block text-center w-full py-2 bg-blue-600 hover:bg-blue-500 text-white font-bold text-xs rounded-xl transition-all shadow-md\" href=\"/\">Use Requirements in Resizer Tool →</a></div><div class=\"bg-gray-900 border border-gray-800 rounded-2xl p-5 space-y-4 shadow-xl\"><div class=\"flex items-center justify-between border-b border-gray-800 pb-3\"><div><h3 class=\"font-bold text-white text-base\">Railway (RRB NTPC / Group D / ALP)</h3><p class=\"text-xs text-gray-400\">Railway Recruitment Board</p></div><span cl