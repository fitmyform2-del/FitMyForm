-pointer\" href=\"/convert-to-jpg\"><div class=\"space-y-4\"><div class=\"flex items-center justify-between\"><div class=\"w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500/20 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-image w-6 h-6 text-amber-400\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><circle cx=\"10\" cy=\"12\" r=\"2\"></circle><path d=\"m20 17-1.296-1.296a2.41 2.41 0 0 0-3.408 0L9 22\"></path></svg></div></div><div><h3 class=\"font-semibold text-slate-100 group-hover:text-white flex items-center gap-1.5 transition-colors\"><span>Convert to JPG</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4 text-slate-500 group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-all\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></h3><p class=\"text-xs text-slate-400 mt-1.5 leading-relaxed\">Turn PNG, GIF, TIF, PSD, SVG, WEBP, HEIC, or RAW format images to JPG in bulk with ease.</p></div></div><div class=\"mt-4 pt-3 border-t border-slate-700/50 flex items-center justify-between text-[11px] text-slate-500\"><span class=\"capitalize font-medium\">convert</span><span class=\"text-indigo-400 font-medium group-hover:underline\">Open Tool →</span></div></a><a class=\"group relative bg-slate-800 hover:bg-slate-700/80 p-5 rounded-xl border border-slate-700 flex flex-col justify-between transition-colors shadow-sm cursor-pointer\" href=\"/jpg-to-image\"><div class=\"space-y-4\"><div class=\"flex items-center justify-between\"><div class=\"w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500/20 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-repeat w-6 h-6 text-cyan-400\" aria-hidden=\"true\"><path d=\"m17 2 4 4-4 4\"></path><path d=\"M3 11v-1a4 4 0 0 1 4-4h14\"></path><path d=\"m7 22-4-4 4-4\"></path><path d=\"M21 13v1a4 4 0 0 1-4 4H3\"></path></svg></div></div><div><h3 class=\"font-semibold text-slate-100 group-hover:text-white flex items-center gap-1.5 transition-colors\"><span>Convert from JPG</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4 text-slate-500 group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-all\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></h3><p class=\"text-xs text-slate-400 mt-1.5 leading-relaxed\">Turn JPG images to PNG, WEBP, and GIF. Choose several JPGs to create an animated GIF in seconds!</p></div></div><div class=\"mt-4 pt-3 border-t border-slate-700/50 flex items-center justify-between text-[11px] text-slate-500\"><span class=\"capitalize font-medium\">convert</span><span class=\"text-indigo-400 font-medium group-hover:underline\">Open Tool →</span></div></a><a class=\"group relative bg-slate-800 hover:bg-slate-700/80 p-5 rounded-xl border border-slate-700 flex flex-col justify-between transition-colors shadow-sm cursor-pointer\" href=\"/photo-editor\"><div class=\"space-y-4\"><div class=\"flex items-center justify-between\"><div class=\"w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500/20 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-wand-sparkles w-6 h-6 text-pink-400\" aria-hidden=\"true\"><path d=\"m21.64 3.64-1.28-1.28a1.21 1.21 0 0 0-1.72 0L2.36 18.64a1.21 1.21 0 0 0 0 1.72l1.28 1.28a1.2 1.2 0 0 0 1.72 0L21.64 5.36a1.2 1.2 0 0 0 0-1.72\"></path><path d=\"m14 7 3 3\"></path><path d=\"M5 6v4\"></path><path d=\"M19 14v4\"></path><path d=\"M10 2v2\"></path><path d=\"M7 8H3\"></path><path d=\"M21 16h-4\"></path><path d=\"M11 3H9\"></path></svg></div><span class=\"text-[10px] font-semibold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20\">Popular</span></div><div><h3 class=\"font-semibold text-slate-100 group-hover:text-white flex items-center gap-1.5 transition-colors\"><span>Photo Editor</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4 text-slate-500 group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-all\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></h3><p class=\"text-xs text-slate-400 mt-1.5 leading-relaxed\">Spice up your pictures with filters, text, crop, brightness, contrast, stickers, and simple editing tools.</p></div></div><div class=\"mt-4 pt-3 border-t border-slate-700/50 flex items-center justify-between text-[11px] text-slate-500\"><span class=\"capitalize font-medium\">create</span><span class=\"text-indigo-400 font-medium group-hover:underline\">Open Tool →</span></div></a><a class=\"group relative bg-slate-800 hover:bg-slate-700/80 p-5 rounded-xl border border-slate-700 flex flex-col justify-between transition-colors shadow-sm cursor-pointer\" href=\"/upscale-image\"><div class=\"space-y-4\"><div class=\"flex items-center justify-between\"><div class=\"w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500/20 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles w-6 h-6 text-emerald-400\" aria-hidden=\"true\"><path d=\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\"></path><path d=\"M20 2v4\"></path><path d=\"M22 4h-4\"></path><circle cx=\"4\" cy=\"20\" r=\"2\"></circle></svg></div><span class=\"text-[10px] font-semibold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20\">New</span></div><div><h3 class=\"font-semibold text-slate-100 group-hover:text-white flex items-center gap-1.5 transition-colors\"><span>Upscale Image</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4 text-slate-500 group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-all\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></h3><p class=\"text-xs text-slate-400 mt-1.5 leading-relaxed\">Enlarge your images with high resolution. Easily increase the size of your JPG and PNG images 2x or 4x.</p></div></div><div class=\"mt-4 pt-3 border-t border-slate-700/50 flex items-center justify-between text-[11px] text-slate-500\"><span class=\"capitalize font-medium\">optimize</span><span class=\"text-indigo-400 font-medium group-hover:underline\">Open Tool →</span></div></a><a class=\"group relative bg-slate-800 hover:bg-slate-700/80 p-5 rounded-xl border border-slate-700 flex flex-col justify-between transition-colors shadow-sm cursor-pointer\" href=\"/remove-background\"><div class=\"space-y-4\"><div class=\"flex items-center justify-between\"><div class=\"w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500/20 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-eraser w-6 h-6 text-indigo-400\" aria-hidden=\"true\"><path d=\"M21 21H8a2 2 0 0 1-1.42-.587l-3.994-3.999a2 2 0 0 1 0-2.828l10-10a2 2 0 0 1 2.829 0l5.999 6a2 2 0 0 1 0 2.828L12.834 21\"></path><path d=\"m5.082 11.09 8.828 8.828\"></path></svg></div><span class=\"text-[10px] font-semibold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20\">New</span></div><div><h3 class=\"font-semibold text-slate-100 group-hover:text-white flex items-center gap-1.5 transition-colors\"><span>Remove Background</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4 text-slate-500 group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-all\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></h3><p class=\"text-xs text-slate-400 mt-1.5 leading-relaxed\">Quickly remove image backgrounds with high accuracy. Instantly detect objects and cut out transparent PNGs.</p></div></div><div class=\"mt-4 pt-3 border-t border-slate-700/50 flex items-center justify-between text-[11px] text-slate-500\"><span class=\"capitalize font-medium\">optimize</span><span class=\"text-indigo-400 font-medium group-hover:underline\">Open Tool →</span></div></a><a class=\"group relative bg-slate-800 hover:bg-slate-700/80 p-5 rounded-xl border border-slate-700 flex flex-col justify-between transition-colors shadow-sm cursor-pointer\" href=\"/watermark-image\"><div class=\"space-y-4\"><div class=\"flex items-center justify-between\"><div class=\"w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500/20 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield w-6 h-6 text-blue-400\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path></svg></div></div><div><h3 class=\"font-semibold text-slate-100 group-hover:text-white flex items-center gap-1.5 transition-colors\"><span>Watermark IMAGE</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4 text-slate-500 group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-all\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></h3><p class=\"text-xs text-slate-400 mt-1.5 leading-relaxed\">Stamp an image or text over your photos in seconds. Choose typography, opacity, rotation, and tile positions.</p></div></div><div class=\"mt-4 pt-3 border-t border-slate-700/50 flex items-center justify-between text-[11px] text-slate-500\"><span class=\"capitalize font-medium\">security</span><span class=\"text-indigo-400 font-medium group-hover:underline\">Open Tool →</span></div></a><a class=\"group relative bg-slate-800 hover:bg-slate-700/80 p-5 rounded-xl border border-slate-700 flex flex-col justify-between transition-colors shadow-sm cursor-pointer\" href=\"/meme-generator\"><div class=\"space-y-4\"><div class=\"flex items-center justify-between\"><div class=\"w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500/20 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-face-slightly-smiling w-6 h-6 text-amber-400\" aria-hidden=\"true\"><path d=\"M15 10V9\"></path><path d=\"M16.472 15a6 6 0 01-8.943 0\"></path><path d=\"M9 10V9\"></path><circle cx=\"12\" cy=\"12\" r=\"10\"></circle></svg></div><span class=\"text-[10px] font-semibold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20\">Fun</span></div><div><h3 class=\"font-semibold text-slate-100 group-hover:text-white flex items-center gap-1.5 transition-colors\"><span>Meme Generator</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4 text-slate-500 group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-all\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></h3><p class=\"text-xs text-slate-400 mt-1.5 leading-relaxed\">Create your memes online with ease. Caption meme images or upload your pictures to make custom memes.</p></div></div><div class=\"mt-4 pt-3 border-t border-slate-700/50 flex items-center justify-between text-[11px] text-slate-500\"><span class=\"capitalize font-medium\">create</span><span class=\"text-indigo-400 font-medium group-hover:underline\">Open Tool →</span></div></a><a class=\"group relative bg-slate-800 hover:bg-slate-700/80 p-5 rounded-xl border border-slate-700 flex flex-col justify-between transition-colors shadow-sm cursor-pointer\" href=\"/rotate-image\"><div class=\"space-y-4\"><div class=\"flex items-center justify-between\"><div class=\"w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500/20 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-rotate-cw w-6 h-6 text-cyan-400\" aria-hidden=\"true\"><path d=\"M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8\"></path><path d=\"M21 3v5h-5\"></path></svg></div></div><div><h3 class=\"font-semibold text-slate-100 group-hover:text-white flex items-center gap-1.5 transition-colors\"><span>Rotate IMAGE</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4 text-slate-500 group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-all\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></h3><p class=\"text-xs text-slate-400 mt-1.5 leading-relaxed\">Rotate many images JPG, PNG, or GIF at the same time clockwise, counter-clockwise, or flip horizontally.</p></div></div><div class=\"mt-4 pt-3 border-t border-slate-700/50 flex items-center justify-between text-[11px] text-slate-500\"><span class=\"capitalize font-medium\">edit</span><span class=\"text-indigo-400 font-medium group-hover:underline\">Open Tool →</span></div></a><a class=\"group relative bg-slate-800 hover:bg-slate-700/80 p-5 rounded-xl border border-slate-700 flex flex-col justify-between transition-colors shadow-sm cursor-pointer\" href=\"/html-to-image\"><div class=\"space-y-4\"><div class=\"flex items-center justify-between\"><div class=\"w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500/20 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-code w-6 h-6 text-purple-400\" aria-hidden=\"true\"><path d=\"m16 18 6-6-6-6\"></path><path d=\"m8 6-6 6 6 6\"></path></svg></div></div><div><h3 class=\"font-semibold text-slate-100 group-hover:text-white flex items-center gap-1.5 transition-colors\"><span>HTML to IMAGE</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4 text-slate-500 group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-all\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></h3><p class=\"text-xs text-slate-400 mt-1.5 leading-relaxed\">Convert web HTML code snippets or custom layouts directly to PNG or JPG images with custom rendering.</p></div></div><div class=\"mt-4 pt-3 border-t border-slate-700/50 flex items-center justify-between text-[11px] text-slate-500\"><span class=\"capitalize font-medium\">convert</span><span class=\"text-indigo-400 font-medium group-hover:underline\">Open Tool →</span></div></a><a class=\"group relative bg-slate-800 hover:bg-slate-700/80 p-5 rounded-xl border border-slate-700 flex flex-col justify-between transition-colors shadow-sm cursor-pointer\" href=\"/blur-face\"><div class=\"space-y-4\"><div class=\"flex items-center justify-between\"><div class=\"w-10 h-10 rounded-lg bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-indigo-400 group-hover:bg-indigo-500/20 transition-colors\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-eye-off w-6 h-6 text-rose-400\" aria-hidden=\"true\"><path d=\"M10.733 5.076a10.744 10.744 0 0 1 11.205 6.575 1 1 0 0 1 0 .696 10.747 10.747 0 0 1-1.444 2.49\"></path><path d=\"M14.084 14.158a3 3 0 0 1-4.242-4.242\"></path><path d=\"M17.479 17.499a10.75 10.75 0 0 1-15.417-5.151 1 1 0 0 1 0-.696 10.75 10.75 0 0 1 4.446-5.143\"></path><path d=\"m2 2 20 20\"></path></svg></div><span class=\"text-[10px] font-semibold text-emerald-400 bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20\">New</span></div><div><h3 class=\"font-semibold text-slate-100 group-hover:text-white flex items-center gap-1.5 transition-colors\"><span>Blur Face / Region</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-4 h-4 text-slate-500 group-hover:text-indigo-400 group-hover:translate-x-0.5 transition-all\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></h3><p class=\"text-xs text-slate-400 mt-1.5 leading-relaxed\">Easily blur out faces, license plates, text, and sensitive areas in photos with pixelation or gaussian blur.</p></div></div><div class=\"mt-4 pt-3 border-t border-slate-700/50 flex items-center justify-between text-[11px] text-slate-500\"><span class=\"capitalize font-medium\">security</span><span class=\"text-indigo-400 font-medium group-hover:underline\">Open Tool →</span></div></a></div></section><section class=\"space-y-8 pt-8 border-t border-white/10\"><div class=\"text-center space-y-2\"><h2 class=\"text-2xl sm:text-3xl font-bold text-white tracking-tight\">Exam Photo &amp; Document Specification Workspace</h2><p class=\"text-xs sm:text-sm text-slate-300\">Format passport photos &amp; signatures to exact KB limits and pixel dimensions for SSC, UPSC, IBPS, RRB, CTET forms.</p></div><div class=\"grid grid-cols-1 lg:grid-cols-12 gap-8 items-start\"><div class=\"lg:col-span-7 space-y-8\"><div class=\"space-y-3\"><div class=\"flex items-center justify-between\"><h2 class=\"text-sm font-semibold text-slate-100 flex items-center gap-2.5\"><span class=\"w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-xs text-white font-bold shadow-sm\">1</span><span>Upload Source Document File</span></h2></div><div class=\"w-full space-y-4\"><input type=\"file\" accept=\"image/jpeg,image/jpg,image/png,image/webp,application/pdf\" class=\"hidden\"/><div class=\"relative border-2 border-dashed rounded-3xl p-6 sm:p-10 text-center transition-all duration-300 group cursor-pointer border-white/15 hover:border-indigo-500/50 bg-[#0d121e]/80 hover:bg-[#0d121e] shadow-xl\"><div class=\"w-16 h-16 rounded-2xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center mx-auto mb-4 group-hover:scale-110 group-hover:bg-indigo-500/20 transition-all duration-300 shadow-inner\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cloud-upload w-8 h-8 text-indigo-400 group-hover:text-indigo-300\" aria-hidden=\"true\"><path d=\"M12 13v8\"></path><path d=\"M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242\"></path><path d=\"m8 17 4-4 4 4\"></path></svg></div><h3 class=\"text-lg font-black text-white mb-1 tracking-tight\">Drag &amp; Drop your photo or document here</h3><p class=\"text-xs text-slate-400 mb-6 max-w-sm mx-auto leading-relaxed\">Passport Photos, Signatures, Thumb Impressions, Certificates (JPG, PNG, WEBP, PDF).</p><div class=\"flex flex-wrap items-center justify-center gap-3\"><button type=\"button\" class=\"px-5 py-2.5 min-h-[44px] bg-gradient-to-r from-indigo-600 to-blue-600 hover:from-indigo-500 hover:to-blue-500 text-white font-bold text-xs rounded-xl shadow-lg shadow-indigo-600/25 flex items-center gap-2 transition-all transform hover:scale-[1.02] cursor-pointer\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-image w-4 h-4\" aria-hidden=\"true\"><rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\" ry=\"2\"></rect><circle cx=\"9\" cy=\"9\" r=\"2\"></circle><path d=\"m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21\"></path></svg><span>Select File from Device</span></button><button type=\"button\" class=\"px-5 py-2.5 min-h-[44px] bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-white font-bold text-xs rounded-xl shadow-lg shadow-amber-500/25 flex items-center gap-2 transition-all transform hover:scale-[1.02] cursor-pointer\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-camera w-4 h-4\" aria-hidden=\"true\"><path d=\"M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z\"></path><circle cx=\"12\" cy=\"13\" r=\"3\"></circle></svg><span>Capture Photo via Camera</span></button></div><div class=\"mt-5 flex items-center justify-center gap-4 text-[11px] text-slate-400 font-medium\"><span class=\"flex items-center gap-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield w-3.5 h-3.5 text-emerald-400\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path></svg> Max file size: 25 MB</span><span>•</span><span class=\"text-emerald-400 font-semibold flex items-center gap-1\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check w-3.5 h-3.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg> 100% Browser In-Memory Processing</span></div></div></div></div><div class=\"space-y-3\"><div class=\"flex items-center justify-between\"><h2 class=\"text-sm font-semibold text-slate-100 flex items-center gap-2.5\"><span class=\"w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-xs text-white font-bold shadow-sm\">2</span><span>Form Specifications &amp; Exam Requirements</span></h2></div><div class=\"bg-[#0d121e] border border-white/15 rounded-3xl p-5 sm:p-7 space-y-6 shadow-2xl relative overflow-hidden backdrop-blur-2xl\"><div class=\"absolute -top-10 -left-10 w-40 h-40 bg-indigo-500/10 blur-3xl pointer-events-none\"></div><div class=\"flex items-center justify-between border-b border-white/10 pb-4\"><h3 class=\"text-base font-extrabold text-white flex items-center gap-2.5 tracking-tight\"><div class=\"w-8 h-8 rounded-xl bg-indigo-500/10 border border-indigo-500/30 flex items-center justify-center\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sliders-horizontal w-4 h-4 text-indigo-400\" aria-hidden=\"true\"><path d=\"M10 5H3\"></path><path d=\"M12 19H3\"></path><path d=\"M14 3v4\"></path><path d=\"M16 17v4\"></path><path d=\"M21 12h-9\"></path><path d=\"M21 19h-5\"></path><path d=\"M21 5h-7\"></path><path d=\"M8 10v4\"></path><path d=\"M8 12H3\"></path></svg></div><span>Target Requirement Specifications</span></h3></div><div class=\"space-y-2.5\"><label class=\"text-xs font-bold uppercase tracking-wider text-slate-400 block\">Document Type Category:</label><div class=\"grid grid-cols-2 sm:grid-cols-4 gap-2\"><button type=\"button\" class=\"p-3 min-h-[44px] rounded-2xl border text-xs font-bold flex items-center gap-2.5 transition-all bg-gradient-to-r from-indigo-600 to-blue-600 border-indigo-400 text-white shadow-lg shadow-indigo-600/30 scale-[1.02]\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-camera w-4 h-4 shrink-0 text-white\" aria-hidden=\"true\"><path d=\"M13.997 4a2 2 0 0 1 1.76 1.05l.486.9A2 2 0 0 0 18.003 7H20a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V9a2 2 0 0 1 2-2h1.997a2 2 0 0 0 1.759-1.048l.489-.904A2 2 0 0 1 10.004 4z\"></path><circle cx=\"12\" cy=\"13\" r=\"3\"></circle></svg><span class=\"truncate\">Passport Photo</span></button><button type=\"button\" class=\"p-3 min-h-[44px] rounded-2xl border text-xs font-bold flex items-center gap-2.5 transition-all bg-white/[0.03] border-white/10 text-slate-300 hover:bg-white/[0.08] hover:text-white hover:border-white/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-pen-tool w-4 h-4 shrink-0 text-indigo-400\" aria-hidden=\"true\"><path d=\"M15.707 21.293a1 1 0 0 1-1.414 0l-1.586-1.586a1 1 0 0 1 0-1.414l5.586-5.586a1 1 0 0 1 1.414 0l1.586 1.586a1 1 0 0 1 0 1.414z\"></path><path d=\"m18 13-1.375-6.874a1 1 0 0 0-.746-.776L3.235 2.028a1 1 0 0 0-1.207 1.207L5.35 15.879a1 1 0 0 0 .776.746L13 18\"></path><path d=\"m2.3 2.3 7.286 7.286\"></path><circle cx=\"11\" cy=\"11\" r=\"2\"></circle></svg><span class=\"truncate\">Signature</span></button><button type=\"button\" class=\"p-3 min-h-[44px] rounded-2xl border text-xs font-bold flex items-center gap-2.5 transition-all bg-white/[0.03] border-white/10 text-slate-300 hover:bg-white/[0.08] hover:text-white hover:border-white/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-fingerprint-pattern w-4 h-4 shrink-0 text-indigo-400\" aria-hidden=\"true\"><path d=\"M12 10a2 2 0 0 0-2 2c0 1.02-.1 2.51-.26 4\"></path><path d=\"M14 13.12c0 2.38 0 6.38-1 8.88\"></path><path d=\"M17.29 21.02c.12-.6.43-2.3.5-3.02\"></path><path d=\"M2 12a10 10 0 0 1 18-6\"></path><path d=\"M2 16h.01\"></path><path d=\"M21.8 16c.2-2 .131-5.354 0-6\"></path><path d=\"M5 19.5C5.5 18 6 15 6 12a6 6 0 0 1 .34-2\"></path><path d=\"M8.65 22c.21-.66.45-1.32.57-2\"></path><path d=\"M9 6.8a6 6 0 0 1 9 5.2v2\"></path></svg><span class=\"truncate\">Thumb Print</span></button><button type=\"button\" class=\"p-3 min-h-[44px] rounded-2xl border text-xs font-bold flex items-center gap-2.5 transition-all bg-white/[0.03] border-white/10 text-slate-300 hover:bg-white/[0.08] hover:text-white hover:border-white/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text w-4 h-4 shrink-0 text-indigo-400\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg><span class=\"truncate\">Declaration</span></button><button type=\"button\" class=\"p-3 min-h-[44px] rounded-2xl border text-xs font-bold flex items-center gap-2.5 transition-all bg-white/[0.03] border-white/10 text-slate-300 hover:bg-white/[0.08] hover:text-white hover:border-white/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-credit-card w-4 h-4 shrink-0 text-indigo-400\" aria-hidden=\"true\"><rect width=\"20\" height=\"14\" x=\"2\" y=\"5\" rx=\"2\"></rect><line x1=\"2\" x2=\"22\" y1=\"10\" y2=\"10\"></line></svg><span class=\"truncate\">Aadhaar / ID</span></button><button type=\"button\" class=\"p-3 min-h-[44px] rounded-2xl border text-xs font-bold flex items-center gap-2.5 transition-all bg-white/[0.03] border-white/10 text-slate-300 hover:bg-white/[0.08] hover:text-white hover:border-white/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-graduation-cap w-4 h-4 shrink-0 text-indigo-400\" aria-hidden=\"true\"><path d=\"M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z\"></path><path d=\"M22 10v6\"></path><path d=\"M6 12.5V16a6 3 0 0 0 12 0v-3.5\"></path></svg><span class=\"truncate\">Marksheet</span></button><button type=\"button\" class=\"p-3 min-h-[44px] rounded-2xl border text-xs font-bold flex items-center gap-2.5 transition-all bg-white/[0.03] border-white/10 text-slate-300 hover:bg-white/[0.08] hover:text-white hover:border-white/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-award w-4 h-4 shrink-0 text-indigo-400\" aria-hidden=\"true\"><path d=\"m15.477 12.89 1.515 8.526a.5.5 0 0 1-.81.47l-3.58-2.687a1 1 0 0 0-1.197 0l-3.586 2.686a.5.5 0 0 1-.81-.469l1.514-8.526\"></path><circle cx=\"12\" cy=\"8\" r=\"6\"></circle></svg><span class=\"truncate\">Certificate</span></button><button type=\"button\" class=\"p-3 min-h-[44px] rounded-2xl border text-xs font-bold flex items-center gap-2.5 transition-all bg-white/[0.03] border-white/10 text-slate-300 hover:bg-white/[0.08] hover:text-white hover:border-white/20\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file w-4 h-4 shrink-0 text-indigo-400\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path></svg><span class=\"truncate\">Other File</span></button></div></div><div class=\"space-y-3 pt-3 border-t border-white/10\"><div class=\"flex items-center justify-between\"><label class=\"text-xs font-bold uppercase tracking-wider text-slate-400\">Target Dimensions (Pixels):</label><span class=\"text-xs font-mono font-bold text-indigo-400 bg-indigo-500/10 px-2.5 py-1 rounded-md border border-indigo-500/20\">200<!-- --> × <!-- -->230<!-- --> px</span></div><div class=\"grid grid-cols-2 gap-3\"><div><span class=\"text-[11px] font-semibold text-slate-400 block mb-1\">Width (px)</span><input type=\"number\" placeholder=\"e.g. 200\" class=\"w-full min-h-[44px] bg-[#080b11] text-white px-3.5 py-2.5 rounded-xl border border-white/15 text-sm font-mono focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all\" value=\"200\"/></div><div><span class=\"text-[11px] font-semibold text-slate-400 block mb-1\">Height (px)</span><input type=\"number\" placeholder=\"e.g. 230\" class=\"w-full min-h-[44px] bg-[#080b11] text-white px-3.5 py-2.5 rounded-xl border border-white/15 text-sm font-mono focus:outline-none focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 transition-all\" value=\"230\"/></div></div><div class=\"flex flex-wrap gap-1.5 text-[11px]\"><span class=\"text-slate-400 font-semibold self-center mr-1\">Presets:</span><button type=\"button\" class=\"bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 text-slate-300 font-medium px-2.5 py-1.5 min-h-[36px] rounded-lg transition-all\">200 × 230 (SSC/Bank Photo)</button><button type=\"button\" class=\"bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 text-slate-300 font-medium px-2.5 py-1.5 min-h-[36px] rounded-lg transition-all\">140 × 60 (Standard Sig)</button><button type=\"button\" class=\"bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 text-slate-300 font-medium px-2.5 py-1.5 min-h-[36px] rounded-lg transition-all\">350 × 350 (UPSC)</button><button type=\"button\" class=\"bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 text-slate-300 font-medium px-2.5 py-1.5 min-h-[36px] rounded-lg transition-all\">350 × 450 (RRB/Passport)</button><button type=\"button\" class=\"bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 text-slate-300 font-medium px-2.5 py-1.5 min-h-[36px] rounded-lg transition-all\">240 × 240 (Thumb Print)</button></div></div><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-3 border-t border-white/10\"><div class=\"space-y-2\"><label class=\"text-xs font-bold uppercase tracking-wider text-slate-400 block\">Target File Format:</label><div class=\"grid grid-cols-3 gap-2\"><button type=\"button\" class=\"py-2.5 min-h-[44px] rounded-xl text-xs font-black font-mono border transition-all bg-emerald-600 border-emerald-400 text-white shadow-lg shadow-emerald-600/30\">JPG</button><button type=\"button\" class=\"py-2.5 min-h-[44px] rounded-xl text-xs font-black font-mono border transition-all bg-white/[0.04] border-white/10 text-slate-300 hover:bg-white/[0.08] hover:text-white\">PNG</button><button type=\"button\" class=\"py-2.5 min-h-[44px] rounded-xl text-xs font-black font-mono border transition-all bg-white/[0.04] border-white/10 text-slate-300 hover:bg-white/[0.08] hover:text-white\">PDF</button></div></div><div class=\"space-y-2\"><label class=\"text-xs font-bold uppercase tracking-wider text-slate-400 block\">Target File Size Limits (KB):</label><div class=\"flex items-center gap-2\"><input type=\"number\" placeholder=\"Min KB\" class=\"w-full min-h-[44px] bg-[#080b11] text-white px-3 py-2.5 rounded-xl border border-white/15 text-sm font-mono focus:outline-none focus:border-indigo-500\" value=\"20\"/><span class=\"text-slate-400 text-xs font-extrabold\">TO</span><input type=\"number\" placeholder=\"Max KB\" class=\"w-full min-h-[44px] bg-[#080b11] text-white px-3 py-2.5 rounded-xl border border-white/15 text-sm font-mono focus:outline-none focus:border-indigo-500\" value=\"50\"/></div></div></div><div class=\"flex flex-wrap gap-1.5 text-[11px] pt-1\"><span class=\"text-slate-400 font-semibold self-center mr-1\">Size Limits:</span><button type=\"button\" class=\"bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 text-slate-300 font-medium px-2.5 py-1.5 min-h-[36px] rounded-lg transition-all\">20–50 KB (SSC Photo)</button><button type=\"button\" class=\"bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 text-slate-300 font-medium px-2.5 py-1.5 min-h-[36px] rounded-lg transition-all\">10–20 KB (SSC Signature)</button><button type=\"button\" class=\"bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 text-slate-300 font-medium px-2.5 py-1.5 min-h-[36px] rounded-lg transition-all\">50–100 KB (Declaration)</button><button type=\"button\" class=\"bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 text-slate-300 font-medium px-2.5 py-1.5 min-h-[36px] rounded-lg transition-all\">20–300 KB (UPSC)</button><button type=\"button\" class=\"bg-white/[0.04] hover:bg-white/[0.1] border border-white/10 text-slate-300 font-medium px-2.5 py-1.5 min-h-[36px] rounded-lg transition-all\">50–500 KB (Certificates)</button></div><div class=\"grid grid-cols-1 sm:grid-cols-2 gap-4 pt-3 border-t border-white/10\"><div class=\"space-y-2\"><label class=\"text-xs font-bold uppercase tracking-wider text-slate-400 block flex items-center justify-between\"><span>Aspect Ratio &amp; Crop Mode:</span></label><div class=\"grid grid-cols-2 gap-2\"><button type=\"button\" class=\"py-2.5 px-3 min-h-[44px] rounded-xl text-xs font-bold border flex items-center justify-center gap-1.5 transition-all bg-gradient-to-r from-indigo-600 to-blue-600 border-indigo-400 text-white shadow-lg shadow-indigo-600/30\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-crop w-3.5 h-3.5 shrink-0\" aria-hidden=\"true\"><path d=\"M6 2v14a2 2 0 0 0 2 2h14\"></path><path d=\"M18 22V8a2 2 0 0 0-2-2H2\"></path></svg><span>Fill Padding</span></button><button type=\"button\" class=\"py-2.5 px-3 min-h-[44px] rounded-xl text-xs font-bold border flex items-center justify-center gap-1.5 transition-all bg-white/[0.04] border-white/10 text-slate-300 hover:bg-white/[0.08] hover:text-white\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-crop w-3.5 h-3.5 shrink-0\" aria-hidden=\"true\"><path d=\"M6 2v14a2 2 0 0 0 2 2h14\"></path><path d=\"M18 22V8a2 2 0 0 0-2-2H2\"></path></svg><span>Center Crop</span></button><button type=\"button\" class=\"py-2.5 px-3 min-h-[44px] rounded-xl text-xs font-bold border flex items-center justify-center gap-1.5 transition-all bg-white/[0.04] border-white/10 text-slate-300 hover:bg-white/[0.08] hover:text-white\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-crop w-3.5 h-3.5 shrink-0\" aria-hidden=\"true\"><path d=\"M6 2v14a2 2 0 0 0 2 2h14\"></path><path d=\"M18 22V8a2 2 0 0 0-2-2H2\"></path></svg><span>Stretch Exact</span></button><button type=\"button\" class=\"py-2.5 px-3 min-h-[44px] rounded-xl text-xs font-bold border flex items-center justify-center gap-1.5 transition-all bg-white/[0.04] border-white/10 text-slate-300 hover:bg-white/[0.08] hover:text-white\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-crop w-3.5 h-3.5 shrink-0\" aria-hidden=\"true\"><path d=\"M6 2v14a2 2 0 0 0 2 2h14\"></path><path d=\"M18 22V8a2 2 0 0 0-2-2H2\"></path></svg><span>Visual Manual Crop</span></button></div></div><div class=\"space-y-2\"><label class=\"text-xs font-bold uppercase tracking-wider text-slate-400 block flex items-center gap-1.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-palette w-3.5 h-3.5 text-indigo-400\" aria-hidden=\"true\"><path d=\"M12 22a1 1 0 0 1 0-20 10 9 0 0 1 10 9 5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l.3.4a1.75 1.75 0 0 1-1.4 2.8z\"></path><circle cx=\"13.5\" cy=\"6.5\" r=\".5\" fill=\"currentColor\"></circle><circle cx=\"17.5\" cy=\"10.5\" r=\".5\" fill=\"currentColor\"></circle><circle cx=\"6.5\" cy=\"12.5\" r=\".5\" fill=\"currentColor\"></circle><circle cx=\"8.5\" cy=\"7.5\" r=\".5\" fill=\"currentColor\"></circle></svg><span>Background Color (For Padding):</span></label><div class=\"flex items-center gap-2\"><button type=\"button\" class=\"flex-1 py-2 min-h-[44px] rounded-xl border text-xs font-bold flex items-center justify-center gap-2 transition-all border-indigo-500 bg-indigo-500/10 text-white shadow-sm\"><span class=\"w-4 h-4 rounded-full border border-slate-600 shadow-sm\" style=\"background-color:#FFFFFF\"></span><span>White</span></button><button type=\"button\" class=\"flex-1 py-2 min-h-[44px] rounded-xl border text-xs font-bold flex items-center justify-center gap-2 transition-all border-white/10 bg-white/[0.04] text-slate-400 hover:text-slate-200\"><span class=\"w-4 h-4 rounded-full border border-slate-600 shadow-sm\" style=\"background-color:#F3F4F6\"></span><span>Light Gray</span></button><button type=\"button\" class=\"flex-1 py-2 min-h-[44px] rounded-xl border text-xs font-bold flex items-center justify-center gap-2 transition-all border-white/10 bg-white/[0.04] text-slate-400 hover:text-slate-200\"><span class=\"w-4 h-4 rounded-full border border-slate-600 shadow-sm\" style=\"background-color:#000000\"></span><span>Black</span></button></div></div></div></div></div><div class=\"mt-6 hidden md:block\"><button disabled=\"\" class=\"w-full py-4 min-h-[52px] rounded-xl font-semibold text-base flex items-center justify-center gap-3 transition-colors shadow-sm bg-slate-800 text-slate-500 cursor-not-allowed border border-slate-700\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles w-5 h-5\" aria-hidden=\"true\"><path d=\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\"></path><path d=\"M20 2v4\"></path><path d=\"M22 4h-4\"></path><circle cx=\"4\" cy=\"20\" r=\"2\"></circle></svg><span>Process &amp; Format Document</span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-arrow-right w-5 h-5\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button></div></div><div class=\"lg:col-span-5 space-y-6\"><h2 class=\"text-sm font-semibold text-slate-100 flex items-center gap-2.5\"><span class=\"w-7 h-7 rounded-lg bg-emerald-600 flex items-center justify-center text-xs text-white font-bold shadow-sm\">3</span><span>Live Verification &amp; Download</span></h2><div class=\"bg-slate-800 border border-slate-700 border-dashed rounded-2xl p-10 text-center text-slate-300 space-y-4\"><div class=\"w-16 h-16 rounded-xl bg-slate-700/50 flex items-center justify-center mx-auto text-slate-400\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sliders-horizontal w-7 h-7\" aria-hidden=\"true\"><path d=\"M10 5H3\"></path><path d=\"M12 19H3\"></path><path d=\"M14 3v4\"></path><path d=\"M16 17v4\"></path><path d=\"M21 12h-9\"></path><path d=\"M21 19h-5\"></path><path d=\"M21 5h-7\"></path><path d=\"M8 10v4\"></path><path d=\"M8 12H3\"></path></svg></div><h4 class=\"font-semibold text-slate-100 text-base\">Live Preview Will Appear Here</h4><p class=\"text-sm text-slate-400 max-w-xs mx-auto leading-relaxed\">Upload your document on the left, adjust specifications or pick an exam preset, and click <strong class=\"text-indigo-400\">Process &amp; Format Document</strong>.</p></div></div></div></section><section class=\"mt-16 border-t border-white/10 pt-12 space-y-12 max-w-5xl mx-auto\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"WebApplication\",\"name\":\"FitMyForm - Student Document Resizer & Formatter\",\"url\":\"https://fitmyform.com\",\"applicationCategory\":\"UtilitiesApplication\",\"operatingSystem\":\"All\",\"browserRequirements\":\"Requires JavaScript. Requires HTML5 Canvas.\",\"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"INR\"},\"description\":\"FitMyForm is an all-in-one free web application providing all features of iLoveIMG alongside specialized exam document resizers. Compress images to KB limits, crop photos visually, convert formats (PNG, WEBP, JPG), upscale low resolution photos, watermark sensitive documents, remove backgrounds, generate memes, and blur faces with 100% browser privacy.\"}</script><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"How to Resize Document for Online Application Forms using FitMyForm\",\"step\":[{\"@type\":\"HowToStep\",\"name\":\"Upload Document\",\"text\":\"Select or drop your photo, signature, thumb impression, or certificate.\"},{\"@type\":\"HowToStep\",\"name\":\"Configure Form Requirements\",\"text\":\"Select exam preset (SSC, UPSC, Banking, CTET) or enter target width, height, and KB limit.\"},{\"@type\":\"HowToStep\",\"name\":\"Process & Download\",\"text\":\"The client-side engine automatically resizes, crops, and compresses your file for instant download.\"}]}</script><div class=\"space-y-3 text-center sm:text-left\"><h2 class=\"text-2xl font-black text-white tracking-tight\">Complete Image Editing &amp; Exam Document Formatting Guide</h2><p class=\"text-xs sm:text-sm text-slate-300 leading-relaxed max-w-3xl\">FitMyForm is an all-in-one free web application providing all features of iLoveIMG alongside specialized exam document resizers. Compress images to KB limits, crop photos visually, convert formats (PNG, WEBP, JPG), upscale low resolution photos, watermark sensitive documents, remove backgrounds, generate memes, and blur faces with 100% browser privacy.</p></div><div class=\"grid grid-cols-1 sm:grid-cols-3 gap-5\"><div class=\"antigravity-card-3d p-6 rounded-3xl space-y-3\"><div class=\"w-10 h-10 rounded-2xl bg-emerald-500/15 border border-emerald-500/35 flex items-center justify-center shadow-inner\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-shield-check w-5 h-5 text-emerald-400\" aria-hidden=\"true\"><path d=\"M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z\"></path><path d=\"m9 12 2 2 4-4\"></path></svg></div><h3 class=\"font-extrabold text-sm text-white\">100% Client-Side Privacy</h3><p class=\"text-xs text-slate-300 leading-relaxed\">No document is ever uploaded to any cloud server. Your sensitive photos, Aadhaar cards, and signatures remain safely inside your browser memory.</p></div><div class=\"antigravity-card-3d p-6 rounded-3xl space-y-3\"><div class=\"w-10 h-10 rounded-2xl bg-indigo-500/15 border border-indigo-500/35 flex items-center justify-center shadow-inner\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-zap w-5 h-5 text-indigo-400\" aria-hidden=\"true\"><path d=\"M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z\"></path></svg></div><h3 class=\"font-extrabold text-sm text-white\">High-Precision Compression</h3><p class=\"text-xs text-slate-300 leading-relaxed\">Iterative binary search quality adjustments guarantee your file fits exactly inside the required KB window (e.g. 20–50 KB) without blurriness.</p></div><div class=\"antigravity-card-3d p-6 rounded-3xl space-y-3\"><div class=\"w-10 h-10 rounded-2xl bg-cyan-500/15 border border-cyan-500/35 flex items-center justify-center shadow-inner\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-text w-5 h-5 text-cyan-400\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"M10 9H8\"></path><path d=\"M16 13H8\"></path><path d=\"M16 17H8\"></path></svg></div><h3 class=\"font-extrabold text-sm text-white\">Official Exam Specs</h3><p class=\"text-xs text-slate-300 leading-relaxed\">Pre-loaded requirements database for SSC, UPSC, IBPS, RRB Railway, NTA NEET/JEE, UPTET, CTET, and University Admissions.</p></div></div><div class=\"glass-panel-antigravity rounded-3xl p-6 space-y-4 shadow-2xl\"><h3 class=\"font-extrabold text-base text-white flex items-center gap-2\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-sparkles w-4 h-4 text-indigo-400\" aria-hidden=\"true\"><path d=\"M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z\"></path><path d=\"M20 2v4\"></path><path d=\"M22 4h-4\"></path><circle cx=\"4\" cy=\"20\" r=\"2\"></circle></svg><span>Standard Indian Exam Document Requirements Cheat Sheet</span></h3><div class=\"overflow-x-auto\"><table class=\"w-full text-xs text-left text-slate-300\"><thead class=\"bg-[#080b11]/80 text-slate-300 uppercase font-mono text-[10px] border-b border-white/10\"><tr><th class=\"p-3.5\">Exam Portal</th><th class=\"p-3.5\">Doc Type</th><th class=\"p-3.5\">Dimensions</th><th class=\"p-3.5\">Target KB Limits</th><th class=\"p-3.5\">Output Format</th></tr></thead><tbody class=\"divide-y divide-white/10 font-mono\"><tr><td class=\"p-3.5 font-extrabold text-white\">SSC (CGL/CHSL)</td><td class=\"p-3.5\">Passport Photo</td><td class=\"p-3.5 text-indigo-300 font-bold\">200 × 230 px</td><td class=\"p-3.5 text-emerald-400 font-bold\">20 – 50 KB</td><td class=\"p-3.5\">JPG / JPEG</td></tr><tr><td class=\"p-3.5 font-extrabold text-white\">SSC (CGL/CHSL)</td><td class=\"p-3.5\">Signature</td><td class=\"p-3.5 text-indigo-300 font-bold\">140 × 60 px</td><td class=\"p-3.5 text-emerald-400 font-bold\">10 – 20 KB</td><td class=\"p-3.5\">JPG / JPEG</td></tr><tr><td class=\"p-3.5 font-extrabold text-white\">UPSC Civil Services</td><td class=\"p-3.5\">Photo &amp; Sig</td><td class=\"p-3.5 text-indigo-300 font-bold\">350 × 350 px (Min)</td><td class=\"p-3.5 text-emerald-400 font-bold\">20 – 300 KB</td><td class=\"p-3.5\">JPG / JPEG</td></tr><tr><td class=\"p-3.5 font-extrabold text-white\">IBPS Banking</td><td class=\"p-3.5\">Left Thumb</td><td class=\"p-3.5 text-indigo-300 font-bold\">240 × 240 px</td><td class=\"p-3.5 text-emerald-400 font-bold\">20 – 50 KB</td><td class=\"p-3.5\">JPG / JPEG</td></tr><tr><td class=\"p-3.5 font-extrabold text-white\">Railway RRB</td><td class=\"p-3.5\">Passport Photo</td><td class=\"p-3.5 text-indigo-300 font-bold\">350 × 450 px</td><td class=\"p-3.5 text-emerald-400 font-bold\">20 – 50 KB</td><td class=\"p-3.5\">JPG / JPEG</td></tr></tbody></table></div></div><div class=\"space-y-5\"><h3 class=\"font-extrabold text-xl text-white flex items-center gap-2.5 tracking-tight\"><div class=\"w-8 h-8 rounded-xl bg-indigo-500/20 border border-indigo-500/40 flex items-center justify-center shadow-inner\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-question-mark w-4 h-4 text-indigo-400\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3\"></path><path d=\"M12 17h.01\"></path></svg></div><span>Frequently Asked Questions (FAQ)</span></h3><div class=\"space-y-3.5\"><div class=\"glass-panel rounded-2xl p-5 space-y-2 shadow-lg\"><h4 class=\"font-extrabold text-white text-sm flex items-start gap-2.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Are all iLoveIMG features completely free on FitMyForm?</span></h4><p class=\"text-xs text-slate-300 pl-6 leading-relaxed\">Yes, 100% free with unlimited usage. You can compress, resize, crop, rotate, watermark, upscale, remove background, generate memes, convert formats, and edit photos without paying or registering.</p></div><div class=\"glass-panel rounded-2xl p-5 space-y-2 shadow-lg\"><h4 class=\"font-extrabold text-white text-sm flex items-start gap-2.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>Are my images uploaded to external servers?</span></h4><p class=\"text-xs text-slate-300 pl-6 leading-relaxed\">No! All processing happens directly inside your web browser using HTML5 Canvas APIs. Your files never leave your computer or phone.</p></div><div class=\"glass-panel rounded-2xl p-5 space-y-2 shadow-lg\"><h4 class=\"font-extrabold text-white text-sm flex items-start gap-2.5\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-circle-check w-4 h-4 text-emerald-400 shrink-0 mt-0.5\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m9 12 2 2 4-4\"></path></svg><span>How do I resize a passport photo to 200 x 230 px and 20–50 KB for SSC exams?</span></h4><p class=\"text-xs text-slate-300 pl-6 leading-relaxed\">Use the SSC Passport Photo preset or select Width: 200 px, Height: 230 px, Min size: 20 KB, Max size: 50 KB, Format: JPG. Click Process &amp; Format Document Now for an instant result.</p></div></div></div></section></main><div class=\"fixed bottom-6 left-1/2 -translate-x-1/2 z-40 md:hidden w-[90%] max-w-[400px] bg-slate-800 p-2 rounded-2xl shadow-xl flex items-center justify-between gap-2 border border-slate-700\"><button class=\"flex-1 py-3 bg-slate-700 hover:bg-slate-600 text-slate-200 rounded-xl text-sm font-semibold flex items-center justify-center gap-2 transition-colors cursor-pointer\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-search w-4 h-4 text-indigo-400\" aria-hidden=\"true\"><path d=\"m21 21-4.34-4.34\"></path><circle cx=\"11\" cy=\"11\" r=\"8\"></circle></svg><span>Exams</span></button><button disabled=\"\" class=\"flex-[1.5] py-3 rounded-xl text-sm font-semibold flex items-center justify-center gap-2 cursor-pointer shadow-sm transition-all bg-slate-700 text-slate-400 border border-slate-600 cursor-not-allowed\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-cloud-upload w-4 h-4\" aria-hidden=\"true\"><path d=\"M12 13v8\"></path><path d=\"M4 14.899A7 7 0 1 1 15.71 8h1.79a4.5 4.5 0 0 1 2.5 8.242\"></path><path d=\"m8 17 4-4 4 4\"></path></svg><span>Select Photo</span></button></div><footer class=\"w-full bg-[#05070c] border-t border-white/10 text-slate-400 py-12 px-4 sm:px-6 lg:px-8 mt-16 relative\"><div class=\"max-w-7xl mx-auto space-y-12\"><div class=\"grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-8\"><div class=\"lg:col-span-2 space-y-4\"><a class=\"flex items-center gap-3 group\" href=\"/\"><div class=\"w-10 h-10 rounded-2xl bg-indigo-600/20 border border-indigo-500/40 flex items-center justify-center text-indigo-400 group-hover:scale-110 transition-transform shadow-inner\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-file-check w-5 h-5\" aria-hidden=\"true\"><path d=\"M6 22a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.704.706l3.588 3.588A2.4 2.4 0 0 1 20 8v12a2 2 0 0 1-2 2z\"></path><path d=\"M14 2v5a1 1 0 0 0 1 1h5\"></path><path d=\"m9 15 2 2 4-4\"></path></svg></div><span class=\"font-extrabold text-xl tracking-tight text-white font-sans\">FitMy<span class=\"gradient-text font-black\">Form</span></span></a><p class=\"text-xs text-slate-300 leadin